<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="referencias">
    <physics type='ode'>
      <max_step_size>0.0005</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>2000</real_time_update_rate>
      <max_contacts>10</max_contacts>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
           <sor>1.3</sor>
           <thread_position_correction>false</thread_position_correction>
        </solver>
        <constraints>
          <cfm>0.00010</cfm>
          <erp>0.3</erp>
          <contact_max_correcting_velocity>0.01</contact_max_correcting_velocity>
          <!-- <contact_surface_layer>0.001</contact_surface_layer> -->
        </constraints>
      </ode>
    </physics>
    <include>
      <uri>model://sun</uri>
    </include>
    <model name="ground_referencia">
      <include>
          <uri>model://ground_referencia</uri>
          <pose>0 0 0 0 0 0</pose>
      </include>
      <pose frame="">0.0 0.0 0.0 0 0 0</pose>
     </model>
    <model name="padrao_17">
      <include>
          <uri>model://padrao_17</uri>
          <pose>0 0 0 0 0 0</pose>
      </include>
      <pose frame="">10 0 0 0 0 3.14159</pose>
     </model>
    <model name="fitas_17">
      <include>
          <uri>model://fitas_17</uri>
          <pose>0 0 0 0 0 0</pose>
      </include>
      <pose frame="">10 0 0 0 0 3.14159</pose>
     </model>
  </world>
</sdf>
