<launch>
    <arg name="sdf" default="$(find-pkg-share drc_simulation)/worlds/ignition.sdf"/>
    <arg name="pause" default="true"/>
    <arg name="gui" default="true"/>
    <arg name="use_sim_time" default="true"/>
    <arg name="robot" default="flexnav1500"/>
   	<arg name="x" default="0.0"/>
	<arg name="y" default="0.0"/>
	<arg name="z" default="0.1"/>

    <arg unless="$(var pause)" name="gz_pause" default="−r"/>
    <arg if="$(var pause)" name="gz_pause" default=""/>

    <arg unless="$(var gui)" name="gz_gui" default="−s"/>
    <arg if="$(var gui)" name="gz_gui" default=""/>

    <group>
        <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
            <arg name="gz_args" value="$(var gui) $(var pause) -r −v4 $(var sdf)"/>
            <arg name="use_sim_time" value="$(var use_sim_time)"/>
            <arg name="on_exit_shutdown" value="true"/>
        </include>

        <include file="$(find-pkg-share drc_flexnav_description)/launch/flexnav.launch.xml">
            <arg name="robot" value="$(var robot)"/>
            <arg name="ignition" value="true"/>
            <arg name="use_sim_time" value="$(var use_sim_time)"/>
        </include>
    </group>

    <node name="flexnav_spawner"
          pkg="ros_gz_sim"
          exec="create"
          args="-topic robot_description -name $(var robot) -x $(var x) -y $(var y) -z $(var z)"/>
</launch>
